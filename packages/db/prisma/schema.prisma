generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  uploading
  queued
  processing
  ready
  failed
}

enum JobStatus {
  waiting
  active
  completed
  failed
}

enum JobType {
  transcode
}

model Video {
  id                String      @id @default(uuid()) @db.Uuid
  title             String
  status            VideoStatus @default(uploading)
  originalKey       String?
  masterPlaylistKey String?
  duration          Float?
  error             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  jobs              Job[]
  renditions        Rendition[]

  @@index([status])
  @@index([createdAt])
}

model Job {
  id        String    @id @default(uuid()) @db.Uuid
  videoId   String    @db.Uuid
  type      JobType   @default(transcode)
  bullJobId String?
  progress  Int       @default(0)
  status    JobStatus @default(waiting)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
}

model Rendition {
  id          String   @id @default(uuid()) @db.Uuid
  videoId     String   @db.Uuid
  height      Int
  bandwidth   Int?
  playlistKey String
  createdAt   DateTime @default(now())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, height])
  @@index([videoId])
}
